.empty {
  padding: 120rpx 48rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 48rpx;
  background: #F1F7F3;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.empty-icon {
  width: 82rpx;
  height: 82rpx;
  opacity: 0.65;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #26332B;
}

.empty-desc {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8A948D;
  max-width: 520rpx;
}

.empty-action {
  margin-top: 32rpx;
  height: 76rpx;
  padding: 0 44rpx;
  border-radius: 38rpx;
  background: #EAF6EE;
  color: #257E4B;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-action-hover {
  opacity: 0.8;
}
