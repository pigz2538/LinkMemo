.help-page {
  padding-bottom: 40rpx;
}

.help-hero {
  margin-top: 22rpx;
  padding: 12rpx 0 4rpx;
}

.help-hero-title {
  font-size: 55rpx;
  font-weight: 700;
  color: #17221C;
  letter-spacing: 1rpx;
}

.help-hero-sub {
  margin-top: 10rpx;
  font-size: 29rpx;
  color: #8A948D;
}

.steps-card {
  margin-top: 24rpx;
  padding: 10rpx 28rpx;
}

.help-step {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F1F5F2;
}

.help-step:last-child {
  border-bottom: none;
}

.help-step-num {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #E9F6EE;
  color: #2E9E5B;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.help-step-main {
  flex: 1;
  min-width: 0;
}

.help-step-title {
  font-size: 33rpx;
  font-weight: 600;
  color: #1F2A24;
}

.help-step-desc {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8A948D;
}

.help-step-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.section-head {
  margin: 38rpx 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-head-title {
  font-size: 39rpx;
  font-weight: 700;
  color: #1B2620;
}

.section-head-action {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #2E9E5B;
}

.example-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.example-card {
  padding: 22rpx 26rpx;
  border-radius: 20rpx;
}

.example-type {
  font-size: 25rpx;
  font-weight: 600;
  color: #2E9E5B;
  margin-bottom: 8rpx;
}

.example-sample {
  font-size: 28rpx;
  line-height: 1.6;
  color: #526058;
  word-break: break-all;
}

.limit-card {
  margin-top: 30rpx;
  background: #FFF8EF;
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
}

.limit-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #8A5A1F;
  margin-bottom: 12rpx;
}

.limit-icon {
  width: 32rpx;
  height: 32rpx;
}

.limit-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 8rpx 0;
  font-size: 26rpx;
  line-height: 1.65;
  color: #8A6A45;
}

.limit-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #D7A25E;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.faq-head {
  margin-top: 34rpx;
}

.faq-card {
  padding: 0 28rpx;
}

.faq-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F1F5F2;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.faq-q-text {
  flex: 1;
  font-size: 31rpx;
  font-weight: 500;
  color: #26332B;
  line-height: 1.5;
}

.faq-arrow {
  width: 28rpx;
  height: 28rpx;
  transition: transform 0.2s;
  flex-shrink: 0;
}

.faq-arrow-open {
  transform: rotate(180deg);
}

.faq-answer {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  background: #F6FAF7;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1.75;
  color: #5A6860;
}

.feedback-card {
  margin-top: 30rpx;
  padding: 30rpx 28rpx;
}

.feedback-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2A24;
}

.feedback-desc {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #8A948D;
}

.feedback-actions {
  margin-top: 22rpx;
  display: flex;
  gap: 18rpx;
}

.feedback-btn {
  flex: 1;
  height: 80rpx;
  font-size: 30rpx;
}

.feedback-email {
  margin-top: 18rpx;
  text-align: center;
  font-size: 25rpx;
  color: #9AA39D;
}

.help-footer {
  margin-top: 34rpx;
  text-align: center;
  font-size: 24rpx;
  color: #A5AEA8;
}
