.edit-page {
  padding-bottom: 20rpx;
}

.edit-card {
  margin-top: 22rpx;
  padding: 4rpx 28rpx;
}

.form-row {
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F1F5F2;
}

.form-row-last {
  border-bottom: none;
}

.form-label {
  display: block;
  font-size: 29rpx;
  color: #7C8781;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 76rpx;
  font-size: 34rpx;
  color: #17221C;
}

.input-placeholder {
  color: #A5AEA8;
  font-size: 31rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 33rpx;
  line-height: 1.65;
  color: #17221C;
}

.picker-value {
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 34rpx;
  color: #17221C;
}

.picker-arrow {
  width: 30rpx;
  height: 30rpx;
}

.edit-section {
  margin-top: 26rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  padding: 24rpx 28rpx 28rpx;
  box-shadow: 0 10rpx 32rpx rgba(22, 61, 36, 0.055);
}

.edit-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.edit-section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #26332B;
}

.edit-create {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: #2E9E5B;
  padding: 6rpx 4rpx;
}

.edit-chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.edit-chip {
  height: 64rpx;
  padding: 0 22rpx;
  border-radius: 32rpx;
  background: #F3F6F4;
  color: #59665E;
  font-size: 29rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  border: 1rpx solid transparent;
}

.edit-chip.on {
  background: #E9F6EE;
  color: #1F2A24;
  border-color: rgba(46, 158, 91, 0.42);
  font-weight: 500;
}

.edit-empty {
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #9AA39D;
}

.edit-tip {
  margin-top: 24rpx;
  padding: 0 8rpx;
  font-size: 25rpx;
  line-height: 1.65;
  color: #9AA39D;
}

.edit-space {
  height: 150rpx;
}

.edit-bar {
  gap: 20rpx;
}

.edit-cancel {
  flex: 0.7;
  height: 88rpx;
  font-size: 32rpx;
}

.edit-save {
  flex: 1.3;
  height: 88rpx;
  font-size: 33rpx;
}

.loading-wrap {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  color: #8A948D;
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 5rpx solid #E2F1E8;
  border-top-color: #2E9E5B;
  animation: spin 0.8s linear infinite;
}
