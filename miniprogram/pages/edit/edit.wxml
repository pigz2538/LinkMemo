<view class="page edit-page">
  <nav-bar title="编辑归档" show-back="{{true}}" />

  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-spinner"></view>
    <text>正在加载…</text>
  </view>

  <block wx:else>
    <view class="page-inner">
      <view class="edit-card card">
        <view class="form-row">
          <text class="form-label">内容类型</text>
          <picker range="{{typeOptions}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange">
            <view class="picker-value">
              <text>{{typeOptions[typeIndex].label}}</text>
              <image class="picker-arrow" src="/assets/icons/chevron-down-gray.png" mode="aspectFit" />
            </view>
          </picker>
        </view>

        <view class="form-row">
          <text class="form-label">标题</text>
          <input class="form-input" value="{{title}}" maxlength="200" bindinput="onTitleInput" placeholder="请输入标题" />
        </view>

        <view class="form-row">
          <text class="form-label">链接</text>
          <input
            class="form-input"
            value="{{url}}"
            maxlength="2000"
            bindinput="onUrlInput"
            placeholder="可选，以 http:// 或 https:// 开头"
            placeholder-class="input-placeholder"
          />
        </view>

        <view class="form-row form-row-last">
          <text class="form-label">备注</text>
          <textarea
            class="form-textarea"
            value="{{note}}"
            maxlength="2000"
            placeholder="补充说明、待办提醒等"
            placeholder-class="input-placeholder"
            show-confirm-bar="{{false}}"
            bindinput="onNoteInput"
          />
        </view>
      </view>

      <view class="edit-section">
        <view class="edit-section-head">
          <text class="edit-section-title">分类</text>
          <view class="edit-create" bindtap="onCreateCategory">
            <image class="icon-28" src="/assets/icons/plus-green.png" mode="aspectFit" />
            <text>新建</text>
          </view>
        </view>
        <view class="edit-chip-wrap">
          <view
            wx:for="{{categoryOptions}}"
            wx:key="_id"
            class="edit-chip {{categoryId == item._id ? 'on' : ''}}"
            data-id="{{item._id}}"
            bindtap="onCategoryTap"
          >
            <view wx:if="{{item.color}}" class="color-dot" style="background: {{item.color}};"></view>
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>

      <view class="edit-section">
        <view class="edit-section-head">
          <text class="edit-section-title">标签</text>
          <view class="edit-create" bindtap="onCreateTag">
            <image class="icon-28" src="/assets/icons/plus-green.png" mode="aspectFit" />
            <text>新建</text>
          </view>
        </view>
        <view class="edit-chip-wrap">
          <view
            wx:for="{{tags}}"
            wx:key="_id"
            class="edit-chip {{item.checked ? 'on' : ''}}"
            data-id="{{item._id}}"
            bindtap="onTagTap"
          >
            <view class="color-dot" style="background: {{item.color}};"></view>
            <text>{{item.name}}</text>
          </view>
          <view wx:if="{{!tags.length}}" class="edit-empty">还没有标签，点击右上角新建</view>
        </view>
      </view>

      <view class="edit-tip">内容类型由系统识别，如果识别不准确可以手动调整；网页抓取失败不影响原始内容保存。</view>
      <view class="edit-space"></view>
    </view>

    <view class="bottombar edit-bar">
      <view class="btn btn-ghost edit-cancel" hover-class="btn-hover" bindtap="onCancel">取消</view>
      <view class="btn btn-primary edit-save" hover-class="btn-hover" bindtap="onSave">{{saving ? '保存中…' : '保存修改'}}</view>
    </view>
  </block>
</view>
