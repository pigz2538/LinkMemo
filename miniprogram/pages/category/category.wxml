<view class="page category-page">
  <nav-bar title="分类与标签" show-back="{{true}}" />

  <view class="page-inner">
    <view class="head-row">
      <view>
        <view class="page-title">分类与标签</view>
        <view class="page-desc">用分类组织归属，用标签做更细的多对多标记</view>
      </view>
      <view class="add-btn" hover-class="add-btn-hover" bindtap="openCreate">
        <image class="icon-36" src="/assets/icons/plus-white.png" mode="aspectFit" />
      </view>
    </view>

    <view class="segment category-segment">
      <view class="segment-item {{tab == 'category' ? 'active' : ''}}" data-tab="category" bindtap="onTabTap">
        分类 {{categories.length}}
      </view>
      <view class="segment-item {{tab == 'tag' ? 'active' : ''}}" data-tab="tag" bindtap="onTabTap">
        标签 {{tags.length}}
      </view>
    </view>

    <view wx:if="{{loading}}" class="loading-wrap">
      <view class="loading-spinner"></view>
      <text>正在加载…</text>
    </view>

    <block wx:elif="{{tab == 'category'}}">
      <view wx:if="{{categories.length}}" class="list-card card">
        <view
          wx:for="{{categories}}"
          wx:key="_id"
          class="manage-row"
          data-type="category"
          data-id="{{item._id}}"
          data-name="{{item.name}}"
          data-color="{{item.color}}"
          bindtap="onRowTap"
          hover-class="manage-row-hover"
        >
          <view class="manage-color" style="background: {{item.color}};"></view>
          <view class="manage-main">
            <view class="manage-name">{{item.name}}</view>
            <view class="manage-count">{{item.usage_count}} 条记录</view>
          </view>
          <view class="manage-actions">
            <view
              class="manage-action"
              data-type="category"
              data-id="{{item._id}}"
              data-name="{{item.name}}"
              data-color="{{item.color}}"
              catchtap="openEdit"
            >
              <image class="icon-32" src="/assets/icons/edit-gray.png" mode="aspectFit" />
            </view>
            <view
              class="manage-action"
              data-type="category"
              data-id="{{item._id}}"
              data-name="{{item.name}}"
              catchtap="onDelete"
            >
              <image class="icon-32" src="/assets/icons/trash-gray.png" mode="aspectFit" />
            </view>
            <image class="manage-arrow" src="/assets/icons/chevron-gray.png" mode="aspectFit" />
          </view>
        </view>
      </view>
      <empty-state
        wx:else
        title="还没有自定义分类"
        desc="创建「工作」「学习」「求职」等分类，让归档更有条理"
        icon="/assets/icons/folder-gray.png"
        action-text="新建分类"
        bind:action="openCreate"
      />
    </block>

    <block wx:else>
      <view wx:if="{{tags.length}}" class="tag-cloud">
        <view
          wx:for="{{tags}}"
          wx:key="_id"
          class="tag-card card"
          data-type="tag"
          data-id="{{item._id}}"
          data-name="{{item.name}}"
          data-color="{{item.color}}"
          bindtap="onRowTap"
          hover-class="manage-row-hover"
        >
          <view class="tag-card-top">
            <view class="tag-color-line" style="background: {{item.color}};"></view>
            <view class="manage-actions">
              <view
                class="manage-action"
                data-type="tag"
                data-id="{{item._id}}"
                data-name="{{item.name}}"
                data-color="{{item.color}}"
                catchtap="openEdit"
              >
                <image class="icon-30" src="/assets/icons/edit-gray.png" mode="aspectFit" />
              </view>
              <view
                class="manage-action"
                data-type="tag"
                data-id="{{item._id}}"
                data-name="{{item.name}}"
                catchtap="onDelete"
              >
                <image class="icon-30" src="/assets/icons/trash-gray.png" mode="aspectFit" />
              </view>
            </view>
          </view>
          <view class="tag-card-name">{{item.name}}</view>
          <view class="tag-card-count">{{item.usage_count}} 条记录</view>
        </view>
        <view class="tag-cloud-add" bindtap="openCreate">
          <image class="icon-32" src="/assets/icons/plus-green.png" mode="aspectFit" />
          <text>新建标签</text>
        </view>
      </view>
      <empty-state
        wx:else
        title="还没有标签"
        desc="标签可以多对多标记，例如「待阅读」「重要」「论文」"
        icon="/assets/icons/tag-gray.png"
        action-text="新建标签"
        bind:action="openCreate"
      />
    </block>

    <view class="page-note">删除分类不会删除记录，记录会变为「未分类」；删除标签只解除关联。</view>
  </view>

  <view wx:if="{{showEditor}}" class="mask" catchtap="closeEditor"></view>
  <view wx:if="{{showEditor}}" class="sheet editor-sheet">
    <view class="sheet-handle"></view>
    <view class="sheet-head">
      <text class="sheet-title">{{editorMode == 'create' ? '新建' : '编辑'}}{{editorType == 'category' ? '分类' : '标签'}}</text>
      <view class="sheet-close" bindtap="closeEditor">
        <image class="icon-28" src="/assets/icons/close-gray.png" mode="aspectFit" />
      </view>
    </view>

    <view class="editor-preview">
      <view class="editor-chip" style="color: {{editorColor}};">
        <view class="color-dot" style="background: {{editorColor}};"></view>
        <text>{{editorName || (editorType == 'category' ? '分类名称' : '标签名称')}}</text>
      </view>
    </view>

    <view class="form-row">
      <text class="form-label">名称</text>
      <input
        class="form-input"
        value="{{editorName}}"
        maxlength="20"
        focus="{{showEditor}}"
        placeholder="{{editorType == 'category' ? '例如：工作、学习、求职' : '例如：待阅读、重要、论文'}}"
        placeholder-class="input-placeholder"
        bindinput="onNameInput"
      />
    </view>

    <view class="editor-color-title">颜色</view>
    <view class="color-grid">
      <view
        wx:for="{{colorPalette}}"
        wx:key="*this"
        class="color-option {{editorColor == item ? 'on' : ''}}"
        data-color="{{item}}"
        bindtap="onColorTap"
      >
        <view class="color-option-inner" style="background: {{item}};">
          <image wx:if="{{editorColor == item}}" class="color-check" src="/assets/icons/check-white.png" mode="aspectFit" />
        </view>
      </view>
    </view>

    <view class="sheet-foot">
      <view class="btn btn-ghost editor-cancel" hover-class="btn-hover" bindtap="closeEditor">取消</view>
      <view class="btn btn-primary editor-save" hover-class="btn-hover" bindtap="onSaveEditor">{{saving ? '保存中…' : '保存'}}</view>
    </view>
  </view>
</view>
