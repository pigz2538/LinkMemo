.category-page {
  padding-bottom: 30rpx;
}

.head-row {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.page-desc {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #8A948D;
  max-width: 520rpx;
}

.add-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #35A863 0%, #24834B 100%);
  box-shadow: 0 12rpx 28rpx rgba(46, 158, 91, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 6rpx;
}

.add-btn-hover {
  opacity: 0.82;
}

.category-segment {
  margin-top: 30rpx;
}

.list-card {
  margin-top: 24rpx;
  padding: 0 28rpx;
}

.manage-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F1F5F2;
}

.manage-row:last-child {
  border-bottom: none;
}

.manage-row-hover {
  opacity: 0.75;
}

.manage-color {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.manage-main {
  flex: 1;
  min-width: 0;
}

.manage-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2A24;
}

.manage-count {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #9AA39D;
}

.manage-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.manage-action {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F5F8F6;
  display: flex;
  align-items: center;
  justify-content: center;
}

.manage-arrow {
  width: 28rpx;
  height: 28rpx;
  margin-left: 4rpx;
}

.tag-cloud {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.tag-card {
  width: calc(50% - 9rpx);
  padding: 22rpx;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(22, 61, 36, 0.055);
}

.tag-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag-color-line {
  width: 44rpx;
  height: 8rpx;
  border-radius: 4rpx;
}

.tag-card-name {
  margin-top: 18rpx;
  font-size: 37rpx;
  font-weight: 600;
  color: #1F2A24;
}

.tag-card-count {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: #9AA39D;
}

.tag-cloud-add {
  width: calc(50% - 9rpx);
  min-height: 168rpx;
  border: 2rpx dashed #CFE2D5;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  color: #4C8A61;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.55);
}

.page-note {
  margin-top: 28rpx;
  padding: 0 8rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #9AA39D;
}

.editor-sheet {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.editor-preview {
  padding: 8rpx 0 22rpx;
}

.editor-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 28rpx;
  background: #F3F6F4;
  font-size: 29rpx;
}

.editor-color-title {
  margin: 24rpx 0 16rpx;
  font-size: 29rpx;
  color: #7C8781;
}

.color-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  padding-bottom: 10rpx;
}

.color-option {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  padding: 4rpx;
  border: 2rpx solid transparent;
}

.color-option.on {
  border-color: #2E9E5B;
}

.color-option-inner {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.color-check {
  width: 32rpx;
  height: 32rpx;
}

.editor-cancel {
  flex: 0.7;
  height: 86rpx;
  font-size: 32rpx;
}

.editor-save {
  flex: 1.3;
  height: 86rpx;
  font-size: 32rpx;
}

.input-placeholder {
  color: #A5AEA8;
  font-size: 31rpx;
}

.loading-wrap {
  padding: 100rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22rpx;
  color: #8A948D;
  font-size: 28rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 5rpx solid #E2F1E8;
  border-top-color: #2E9E5B;
  animation: spin 0.8s linear infinite;
}
