.mine-page {
  padding-bottom: 30rpx;
}

.profile {
  margin-top: 20rpx;
  padding: 30rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.profile-hover {
  opacity: 0.86;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #EAF6EE;
  flex-shrink: 0;
}

.profile-main {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #17221C;
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8A948D;
}

.profile-arrow {
  width: 32rpx;
  height: 32rpx;
}

.stats-panel {
  margin-top: 22rpx;
  background: #EAF7EF;
  border-radius: 24rpx;
  padding: 28rpx 0;
  display: flex;
  align-items: center;
}

.stats-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stats-num {
  font-size: 46rpx;
  font-weight: 700;
  color: #1C2A22;
  line-height: 1.1;
}

.stats-label {
  font-size: 23rpx;
  color: #6C7B71;
}

.stats-line {
  width: 1rpx;
  height: 52rpx;
  background: rgba(46, 158, 91, 0.16);
}

.menu-card {
  margin-top: 22rpx;
  padding: 0 28rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #F1F5F2;
}

.menu-row-last {
  border-bottom: none;
}

.menu-row-hover {
  opacity: 0.7;
}

.menu-icon {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #233029;
  font-weight: 500;
}

.menu-extra {
  font-size: 23rpx;
  color: #9AA39D;
}

.menu-arrow {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.logout-btn {
  margin-top: 30rpx;
  height: 92rpx;
  border-radius: 22rpx;
  background: #EAF7EF;
  color: #2E9E5B;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn {
  background: #2E9E5B;
  color: #FFFFFF;
}

.logout-hover {
  opacity: 0.82;
}

.mine-footer {
  margin-top: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 21rpx;
  color: #A5AEA8;
}

.mine-footer-dot {
  color: #C9D2CC;
}

.option-list {
  padding-bottom: 16rpx;
}

.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 6rpx;
  border-bottom: 1rpx solid #F1F5F2;
}

.option-row:last-child {
  border-bottom: none;
}

.option-main {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.option-label {
  font-size: 30rpx;
  color: #1F2A24;
  font-weight: 500;
}

.option-desc {
  font-size: 22rpx;
  color: #9AA39D;
}

.option-check {
  width: 40rpx;
  height: 40rpx;
}

.data-sheet {
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

.data-list {
  padding-bottom: 10rpx;
}

.data-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F1F5F2;
}

.data-row:last-child {
  border-bottom: none;
}

.data-row-hover {
  opacity: 0.72;
}

.data-icon-wrap {
  width: 68rpx;
  height: 68rpx;
  border-radius: 18rpx;
  background: #F5F8F6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.data-main {
  flex: 1;
  min-width: 0;
}

.data-title {
  font-size: 28rpx;
  color: #233029;
  font-weight: 500;
}

.data-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #9AA39D;
}

.data-extra {
  font-size: 22rpx;
  color: #9AA39D;
}

.data-arrow {
  width: 28rpx;
  height: 28rpx;
}

.data-row-danger .data-title {
  color: #DA5A5A;
}

.about-sheet {
  align-items: center;
  text-align: center;
  padding-bottom: calc(34rpx + env(safe-area-inset-bottom));
}

.about-logo {
  width: 108rpx;
  height: 108rpx;
  border-radius: 30rpx;
  background: #E9F6EE;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 14rpx;
}

.about-logo-icon {
  width: 62rpx;
  height: 62rpx;
}

.about-title {
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #17221C;
}

.about-version {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9AA39D;
}

.about-text {
  margin-top: 22rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #526058;
  max-width: 560rpx;
}

.about-points {
  margin-top: 26rpx;
  width: 100%;
  text-align: left;
  background: #F6FAF7;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.about-point {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 9rpx 0;
  font-size: 23rpx;
  line-height: 1.55;
  color: #607067;
}

.about-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #2E9E5B;
  margin-top: 12rpx;
  flex-shrink: 0;
}

.about-btn {
  margin-top: 28rpx;
  width: 100%;
  height: 86rpx;
  font-size: 28rpx;
}
