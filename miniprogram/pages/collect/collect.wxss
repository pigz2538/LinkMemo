.collect-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 8rpx 40rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.hero-brand {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-tile {
  position: absolute;
  left: 100%;
  top: 50%;
  transform: translateY(-50%);
  margin-left: 14rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #E7F6EC 0%, #DDF1E4 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(46, 158, 91, 0.12);
}

.logo-icon {
  width: 52rpx;
  height: 52rpx;
}

.hero-title {
  position: relative;
  z-index: 2;
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  line-height: 1.1;
  color: #0F1A13;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 30rpx;
  color: #68756D;
  letter-spacing: 1rpx;
}

.collect-body {
  margin-top: 28rpx;
}

.paste-card {
  position: relative;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(46, 158, 91, 0.32);
  border-radius: 26rpx;
  box-shadow: 0 14rpx 44rpx rgba(28, 74, 44, 0.07);
  padding: 30rpx 30rpx 58rpx;
  min-height: 520rpx;
}

.paste-input {
  width: 100%;
  height: 440rpx;
  font-size: 34rpx;
  line-height: 1.7;
  color: #223028;
}

.paste-placeholder {
  color: #A5AEA8;
  font-size: 34rpx;
}

.paste-counter {
  position: absolute;
  right: 30rpx;
  bottom: 20rpx;
  font-size: 25rpx;
  color: #A5AEA8;
}

.action-row {
  margin-top: 28rpx;
  display: flex;
  gap: 20rpx;
}

.clipboard-btn {
  flex: 1;
  height: 96rpx;
  font-size: 33rpx;
  gap: 12rpx;
}

.parse-btn {
  flex: 1.12;
  height: 96rpx;
  font-size: 34rpx;
  gap: 12rpx;
}

.btn-icon {
  width: 38rpx;
  height: 38rpx;
}

.dup-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx;
}

.dup-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 29rpx;
  color: #4B5951;
}

.dup-sub {
  font-size: 24rpx;
  color: #9AA39D;
}

.dup-toggle {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dup-state {
  font-size: 26rpx;
  color: #2E9E5B;
}

.switch {
  width: 82rpx;
  height: 46rpx;
  border-radius: 23rpx;
  background: #DCE4DE;
  padding: 4rpx;
  transition: background 0.2s;
}

.switch-on {
  background: #2E9E5B;
}

.switch-knob {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.14);
  transition: transform 0.2s;
}

.switch-on .switch-knob {
  transform: translateX(36rpx);
}

.usage {
  margin-top: 64rpx;
}

.steps {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.step {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.step-num {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #E9F6EE;
  color: #2E9E5B;
  font-size: 25rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-text {
  font-size: 28rpx;
  color: #526058;
  white-space: nowrap;
}

.step-arrow {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.usage-note {
  margin-top: 26rpx;
  text-align: center;
  font-size: 25rpx;
  color: #9AA39D;
}

.parsing-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 800;
  background: rgba(16, 28, 21, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.parsing-card {
  width: 500rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  padding: 52rpx 36rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 30rpx 80rpx rgba(0, 0, 0, 0.16);
}

.parsing-spinner {
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  border: 6rpx solid #E4F2E9;
  border-top-color: #2E9E5B;
  animation: spin 0.8s linear infinite;
}

.parsing-title {
  margin-top: 26rpx;
  font-size: 37rpx;
  font-weight: 600;
  color: #1F2A24;
}

.parsing-desc {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #8A948D;
  text-align: center;
}

.parsing-cancel {
  margin-top: 28rpx;
  font-size: 30rpx;
  color: #7C8781;
  padding: 16rpx 40rpx;
}

.result-sheet {
  padding-top: 8rpx;
}

.result-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0 26rpx;
}

.result-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #EAF7EF;
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-icon {
  width: 58rpx;
  height: 58rpx;
}

.result-title {
  margin-top: 18rpx;
  font-size: 41rpx;
  font-weight: 700;
  color: #1B2620;
}

.result-sub {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #8A948D;
}

.result-stats {
  display: flex;
  align-items: center;
  background: #F5FAF6;
  border-radius: 22rpx;
  padding: 24rpx 0;
}

.result-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.stat-num {
  font-size: 46rpx;
  font-weight: 700;
}

.stat-green {
  color: #2E9E5B;
}

.stat-orange {
  color: #E0A54C;
}

.stat-red {
  color: #DA5A5A;
}

.stat-label {
  font-size: 25rpx;
  color: #8A948D;
}

.stat-line {
  width: 1rpx;
  height: 44rpx;
  background: #E3EAE5;
}

.result-list {
  margin-top: 20rpx;
  height: 360rpx;
}

.result-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 4rpx;
  border-bottom: 1rpx solid #F1F5F2;
}

.result-type-icon {
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
}

.result-item-main {
  flex: 1;
  min-width: 0;
}

.result-item-title {
  font-size: 31rpx;
  color: #223028;
  font-weight: 500;
}

.result-item-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9AA39D;
}

.result-item-dup {
  opacity: 0.72;
}

.result-dup-head {
  margin: 24rpx 4rpx 10rpx;
  font-size: 26rpx;
  color: #9AA39D;
}

.result-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 28rpx;
}

.result-btn {
  flex: 1;
  height: 88rpx;
  font-size: 33rpx;
}

.result-hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8A948D;
  padding: 4rpx 12rpx;
}
